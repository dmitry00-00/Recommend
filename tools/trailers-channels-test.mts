t('язык по латинице и английским субтитрам', () => {
  assert.equal(parse('Scarpetta — Official Trailer (2026) Nicole Kidman').lang, 'en');
  assert.equal(parse('Трудные подростки | Troubled Teens | Trailer (English Subs)').lang, 'ru');
  assert.equal(parse('Фильм «Осколки» | Официальный трейлер (En)').lang, 'en');
});

// ─── 4. порядок роликов у работы (18.10): у сериала первый сезон или общий раньше поздних ─────────────
t('порядок: сериал — первый сезон и общий раньше поздних, фильм — как был', () => {
  const ch = 'UC6A-Z0jDKemh9-CwGbj5yog'; // Kinoman, агрегатор
  const ser: Work = { key: 'tv:1399', title: 'Игра престолов', year: 2011, series: true };
  const film: Work = { key: 'tmdb:9', title: 'Сезон охоты 2', year: 2008, series: false };
  const hit = (title: string, p: string, work: Work) => ({ v: { id: title.slice(0, 11), t: title, p, ch, parsed: parse(title) }, h: { work, via: work.title } });
  const order = (xs: ReturnType<typeof hit>[]) => [...xs].sort(hitOrder).map((x) => x.v.t);
  assert.deepEqual(order([
    hit('Игра престолов (8 сезон) — Русский трейлер (2019)', '2019-03-01', ser),
    hit('Игра престолов (5 сезон) — Русский трейлер (2015)', '2015-02-01', ser),
    hit('Игра престолов — Русский тизер (2011)', '2011-01-01', ser),
    hit('Игра престолов (1 сезон) — Русский трейлер (2011)', '2011-03-01', ser),
  ]), [
    'Игра престолов (1 сезон) — Русский трейлер (2011)', 'Игра престолов — Русский тизер (2011)',
    'Игра престолов (5 сезон) — Русский трейлер (2015)', 'Игра престолов (8 сезон) — Русский трейлер (2019)',
  ]);
  // у фильма слово «сезон» в названии — не сезон: новее раньше, как до 18.10
  assert.deepEqual(order([hit('Сезон охоты 2 — Русский трейлер (2008)', '2008-01-01', film), hit('Сезон охоты 2 — Русский трейлер #2 (2008)', '2008-06-01', film)])[0],
    'Сезон охоты 2 — Русский трейлер #2 (2008)');
});

console.log(`trailers-channels: ${n} проверок пройдено`);
