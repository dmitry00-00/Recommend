// Проверка разбора заголовков и сторожей сопоставления русских трейлеров с каналов прокатчиков (17.10,
// tools/trailers-channels.mts). Заголовки — настоящие, из скачанных загрузок; справочник — маленький, свой.
//
//   npx tsx tools/trailers-channels-test.mts
import assert from 'node:assert/strict';
import { buildIndex, fold, hitOrder, match, parse, type Work } from './trailers-channels.mts';

let n = 0;
const t = (name: string, f: () => void) => { f(); n += 1; void name; };

// ─── 1. трейлер, тизер, не трейлер ───────────────────────────────────────────
const kind = (s: string) => parse(s).kind;
t('трейлеры', () => {
  assert.equal(kind('Фантастические Твари: Тайны Дамблдора | Трейлер 2 | В кино с 14 апреля'), 'T');
  assert.equal(kind('БЭТМЕН I Третий трейлер I Смотрите в кинотеатрах'), 'T');
  assert.equal(kind('Пчеловод 2 — Русский трейлер (Дубляж, 2027)'), 'T');
  assert.equal(kind('Свободная страна_дублированный трейлер'), 'T');
  assert.equal(kind('ХРАБРЫЙ ДАВИД. Русский трейлер. В кино с 30 июля.'), 'T');
});
t('тизеры', () => {
  assert.equal(kind('Падший | Тизер-трейлер | В кино с 10 декабря'), 'S');
  assert.equal(kind('Queen of France | Teaser | 2027'), 'S');
  assert.equal(kind('Король Фриско — Официальный тизер (Субтитры, 2026)'), 'S');
});
t('не трейлеры', () => {
  assert.equal(kind('БЭТМЕН I Cцена из фильма I Смотрите в кинотеатрах'), undefined);
  assert.equal(kind('Телохранитель киллера -- фрагмент №1 (русские субтитры)'), undefined);
  assert.equal(kind('Тюльпанная лихорадка -- тв-спот'), undefined);
  assert.equal(kind('Телохранитель киллера -- интервью с Сальмой Хайек (русские субтитры)'), undefined);
  assert.equal(kind('Фильм Меню (Нестандартные Ужасы) Как снимали'), undefined);
  assert.equal(kind('Битва моторов | Создание фильма | Глава 2: Мотор проекта'), undefined);
  assert.equal(kind('Рождение империи | Специальный ролик | В кино с 29 октября'), undefined);
  assert.equal(kind('ПЕРВЫЙ ВСТРЕЧНЫЙ - фичуретка'), undefined);
  assert.equal(kind('Отрывок из к/ф "Покровские ворота" #shorts #мосфильм'), undefined);
  assert.equal(kind('«Мементо» / Кристофер Нолан / Всеволод Коршунов'), undefined);
  assert.equal(kind('Хотя бы попросите по-людски | Александр Алябьев в сериале «Полураспад». Смотрите только в Okko'), undefined);
});
t('без слова «трейлер» у прокатчика — мягкий трейлер', () => {
  const p = parse('ОНО. КОШМАР С МЕЙПЛ-СТРИТ. В КИНО С 13 НОЯБРЯ!');
  assert.equal(p.kind, 'T');
  assert.equal(p.soft, true);
});

// ─── 2. язык ─────────────────────────────────────────────────────────────────
t('язык', () => {
  assert.equal(parse('Пчеловод 2 — Русский трейлер (Дубляж, 2027)').lang, 'ru');
  assert.equal(parse('Король Фриско — Официальный тизер (Субтитры, 2026)').lang, 'en');
  assert.equal(parse('КИБЕРПАНК: БЕГУЩИЕ ПО КРАЮ 2 Русский трейлер (Субтитры, 2026) Аниме-сериал Netflix HD').lang, 'en');
  assert.equal(parse('Убийцы цветочной луны | Трейлер 2 (Дубляж)').lang, 'ru');
});

// ─── 3. год ──────────────────────────────────────────────────────────────────
t('год из заголовка, не дата проката', () => {
  assert.equal(parse('Пчеловод 2 — Русский трейлер (Дубляж, 2027)').year, 2027);
  assert.equal(parse('Война и мир - Трейлер (2027)').year, 2027);
  assert.equal(parse('Кокаиновый медведь  Русский трейлер  Фильм 2023').year, 2023);
  assert.equal(parse('Искусственный интеллект | Тизер | В кино с 21 января 2027 года').year, undefined);
  assert.equal(parse('«Пчеловод 2» в кино - январь 2027 г.').year, undefined);
  assert.equal(parse('4К-реставрация «Донни Дарко» в кино с 1 сентября 2026').year, undefined);
  assert.equal(parse('4К-реставрация «Донни Дарко» в кино с 1 сентября 2026').rerelease, true);
});

// ─── 4. названия ─────────────────────────────────────────────────────────────
const has = (s: string, name: string) => parse(s).names.map(fold).includes(fold(name));
t('названия', () => {
  assert.ok(has('Фантастические Твари: Тайны Дамблдора | Трейлер 2 | В кино с 14 апреля', 'Фантастические твари: Тайны Дамблдора'));
  assert.ok(has('Оливия Колман и Александр Скарсгард в фильме ПЛЕТЁНЫЙ МУЖ (Wicker) | Трейлер 2. В кино с 5 ноября', 'Плетёный муж'));
  assert.ok(has('Оливия Колман и Александр Скарсгард в фильме ПЛЕТЁНЫЙ МУЖ (Wicker) | Трейлер 2. В кино с 5 ноября', 'Wicker'));
  assert.ok(has('ПЧЕЛОВОД 2 Русский трейлер (4K Дубляж, 2027) Джейсон Стэйтем', 'Пчеловод 2'));
  assert.ok(has('Рамаяна: Восхождение легенды⚔️🔥Официальный трейлер (Дубляж, 4K ULTRA HD, 2026) Фэнтези', 'Рамаяна: Восхождение легенды'));
  assert.ok(has('Шайенн и Лола вне закона | Cheyenne & Lola | Русский трейлер', 'Cheyenne & Lola'));
  assert.ok(has('Бумажный тигр| в кино с 19 ноября | Официальный трейлер', 'Бумажный тигр'));
  assert.ok(has('Свободная страна_дублированный трейлер', 'Свободная страна'));
  assert.ok(has('«Маленькие демоны путешествуют на Запад» – русский трейлер, в кино с 29 октября', 'Маленькие демоны путешествуют на Запад'));
  assert.ok(has('Стук в дверь (М. Найт Шьямалан) - апокалипсис Русский трейлер  Фильм 2023', 'Стук в дверь'));
  // «Новый» в середине названия не срезается
  assert.ok(has('Новый Человек-паук | Трейлер | В кино с 3 июля', 'Новый Человек-паук'));
  // «:» и «. » не режут: «Дюна» из «Дюна: Часть вторая» не получается
  assert.ok(!has('Дюна: Часть вторая | Трейлер | В кино с 1 марта', 'Дюна'));
  assert.ok(!has('ДЮНА. ЧАСТЬ ВТОРАЯ | Трейлер', 'Дюна'));
});

// ─── 5. сопоставление и сторожа ──────────────────────────────────────────────
const W = (key: string, title: string, year: number, orig?: string, series = false): Work => ({ key, title, year, series, ...(orig ? { orig } : {}) });
const index = buildIndex([
  W('tmdb:438631', 'Дюна', 2021, 'Dune'), W('tmdb:841', 'Дюна', 1984, 'Dune'), W('tmdb:693134', 'Дюна: Часть вторая', 2024, 'Dune: Part Two'),
  W('tmdb:1091', 'Нечто', 1982, 'The Thing'), W('tmdb:5000', 'Ёлки', 2010), W('tmdb:5009', 'Ёлки 9', 2022),
  W('tmdb:1', 'Плетёный муж', 2025, 'Wicker'), W('tmdb:2', 'Донни Дарко', 2001, 'Donnie Darko'),
  W('tmdb:3', 'Дом', 2011), W('tmdb:4', 'Дом', 2012), W('tv:100', 'Полураспад', 2026, undefined, true), W('tmdb:101', 'Полураспад', 2025),
  W('tmdb:7', 'Оно', 2017, 'It'), W('tmdb:8', 'Монстр', 2023, 'Monster'), W('tmdb:9', 'Любовь', 2012, 'Amour'), W('tmdb:10', 'Любовь', 2024, 'Love'),
  W('tv:11', 'Цитадель', 2023, 'Citadel', true), W('tv:12', 'Бывшие', 2011, 'The Exes', true), W('tv:13', 'Легенды', 2026, 'Legends', true),
  W('tmdb:14', 'За облаками', 1995, 'Beyond the Clouds'), W('tmdb:15', 'Гунда', 2020), W('tmdb:16', 'Холоп 2', 2024),
  W('tmdb:17', '5 сантиметров в секунду', 2025, '5 Centimeters per Second'), W('tmdb:18', 'Таксист', 1976, 'Taxi Driver', false),
  W('tv:19', 'Дом Дракона', 2022, 'House of the Dragon', true), W('tmdb:20', 'Армия мертвецов', 2021, 'Army of the Dead'),
  W('tmdb:21', 'Кинопроба', 1999, 'Audition'), W('tmdb:24', 'Надежда', 2019, 'Hope'), W('tmdb:22', 'Тёща', 2023), W('tmdb:23', 'Пила 11', 2026),
].map((w) => (w.key === 'tmdb:14' ? { ...w, by: ['Микеланджело Антониони'] } : w.key === 'tmdb:21' ? { ...w, by: ['Такаси Миике'] } : w)));
const at = (title: string, p: string, agg = false, tv = true, old = false) => match({ id: 'x', t: title, p, ch: 'c' }, parse(title), index, { agg, tv, old })?.work.key;
t('Дюна ↔ Дюна: Часть вторая', () => {
  assert.equal(at('Дюна | Трейлер | В кино с 16 сентября', '2021-07-22T00:00:00Z'), 'tmdb:438631');
  assert.equal(at('Дюна: Часть вторая | Трейлер | В кино с 1 марта', '2023-05-03T00:00:00Z'), 'tmdb:693134');
});
t('сиквел с номером', () => {
  assert.equal(at('Ёлки 9 | Трейлер | В кино с 1 декабря', '2022-11-22T00:00:00Z'), 'tmdb:5009');
  // «Ёлки 11» нет в справочнике — не отдаём ни «Ёлкам», ни «Ёлкам 9»
  assert.equal(at('Ёлки 11 | Тизер-трейлер | В кино с 19 декабря', '2024-10-03T00:00:00Z'), undefined);
});
t('ремейк вне окна лет — не он', () => {
  assert.equal(at('Нечто | Трейлер | В кино с 20 октября', '2011-08-01T00:00:00Z'), undefined);
  assert.equal(at('Нечто (1982) | Трейлер', '2015-08-01T00:00:00Z'), 'tmdb:1091');
});
t('повторный прокат', () => {
  assert.equal(at('4К-реставрация «Донни Дарко» в кино с 1 сентября 2026 | трейлер', '2026-09-01T00:00:00Z'), 'tmdb:2');
});
t('тёзки в одном окне — молчим', () => assert.equal(at('Дом | Трейлер', '2012-03-01T00:00:00Z'), undefined));
t('сериал по метке', () => {
  assert.equal(at('Сериал «Полураспад» | Трейлер | Смотрите только в Okko', '2026-10-01T00:00:00Z'), 'tv:100');
  assert.equal(at('Полураспад | Трейлер | В кино с 1 мая', '2025-03-01T00:00:00Z'), 'tmdb:101');
});
t('агрегатор — год в заголовке обязателен', () => {
  assert.equal(at('Плетёный муж — Русский трейлер (Дубляж, 2025)', '2025-09-01T00:00:00Z', true), 'tmdb:1');
  assert.equal(at('Плетёный муж — Русский трейлер (Дубляж)', '2025-09-01T00:00:00Z', true), undefined);
  // или оба названия
  assert.equal(at('Плетёный муж | Wicker | Русский трейлер', '2025-09-01T00:00:00Z', true), 'tmdb:1');
});
t('короткое название — только с годом', () => {
  assert.equal(at('Оно | Трейлер', '2017-03-01T00:00:00Z'), undefined);
  assert.equal(at('Оно (2017) | Трейлер', '2017-03-01T00:00:00Z'), 'tmdb:7');
});

// ─── 6. сторожа по ошибкам выборки 17.10 (настоящие заголовки) ───────────────
t('тире внутри названия', () => {
  // Экспонента: фильма «Мой сосед — монстр» в справочнике нет — «Монстр» 2023-го не он
  assert.equal(at('Мой сосед — монстр | Минутный трейлер', '2024-12-06T00:00:00Z'), undefined);
  assert.equal(at('Любовь - все, что тебе нужно - трейлер (2013)', '2013-02-25T00:00:00Z'), undefined);
  assert.ok(has('Телохранитель киллера - GreenBand - русский трейлер №2', 'Телохранитель киллера'));
