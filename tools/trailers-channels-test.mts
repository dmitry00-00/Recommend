});
t('кинопрокатчик — без метки только фильмы', () => {
  assert.equal(at('Легенды | с 19  февраля | Официальный трейлер | Paradise |', '2025-11-28T00:00:00Z', false, false), undefined);
});
t('украинская дорожка', () => {
  assert.equal(at('Армія мерців | Армия мертвецов | Army of the Dead (2021) | Трейлер на украинском языке', '2021-04-13T00:00:00Z', true), undefined);
});
t('повторный прокат: подпись должна быть режиссёром работы', () => {
  assert.equal(at('Аниме «За облаками» Макото Синкая в кино с 1 мая', '2025-03-26T00:00:00Z', false, false, true), undefined);
  assert.equal(at('«Кинопроба» Такаси Миике в кино с 22 января 2025', '2025-12-09T00:00:00Z', false, false, true), 'tmdb:21');
  assert.equal(at('«Гунда» Виктора Косаковского. Официальный русский трейлер.', '2021-03-17T00:00:00Z', false, false, true), 'tmdb:15');
  // прокат классики не выпускает фильм раньше премьеры
  assert.equal(at('«5 сантиметров в секунду» в кино с 8 февраля', '2024-02-07T00:00:00Z', false, false, true), undefined);
});
t('рассказ о фильме и промо — не трейлер', () => {
  assert.equal(kind('Режиссер Клим Шипенко о фильме «Холоп 2» | Уже в кино'), undefined);
  assert.equal(at('Тёща | Откровения Тёщи и Зятя | Уже в кино', '2023-12-15T00:00:00Z', false, false), undefined);
  assert.equal(kind('Фантастические Твари: Тайны Дамблдора - Премьера трейлера в понедельник'), undefined);
  assert.equal(kind('Пила 11 — Тизер👺 #Пила11 #SawXI #фильм #кино #shorts'), undefined);
  assert.equal(kind('ЧУЖОЙ 7 РОМУЛ - SHORT ТВ-Ролик к Финальному трейлеру (2024) Фильм Ужасов'), undefined);
});
t('названия, которые похожи на обвязку', () => {
  assert.equal(kind('Криминальный город: Разборки в Пусане | Трейлер | В кино с 3 августа'), 'T');
  assert.equal(kind('Лебединая песня — Русский трейлер (2021)'), 'T');
  assert.equal(kind('КЛИПМЕЙКЕРЫ | Трейлер | В кино с 5 января'), 'T');
  assert.equal(kind('До встречи с тобой - второй трейлер'), 'T');
  assert.equal(kind('8 лучших свиданий - Официальный тизер-трейлер (HD)'), 'S');
  assert.equal(kind('Тачки 3 / Cars 3 (2017) Промо-трейлер HD'), 'T');
  assert.ok(has('БОЛЬШОЙ ВСПЛЕСК. Официальный трейлер. Премьера в России - 12 мая.', 'Большой всплеск'));
  assert.ok(has('Судья Дредд 3D Русский трейлер HD1080', 'Судья Дредд'));
  assert.ok(has('МАНХЭТТЕН в кино с 12.09.19 - Русский трейлер с субтитрами', 'Манхэттен'));
});
t('латиница вперемешку, «в кино» в названии, «ролик» до 2012-го', () => {
  assert.equal(kind('Город воров | The Town - Tрейлер'), 'T');
  assert.ok(has('Братья Супер Марио в кино — Официальный дублированный трейлер #2 (2023)', 'Братья Супер Марио в кино'));
  const p = parse('Невероятный Халк (The Incredible Hulk). Русский ролик');
