t('кавычки внутри названия и кусок кавычек', () => {
  assert.equal(at('Координаты «Цитадель» — Русский трейлер (2022)', '2022-06-24T00:00:00Z', true), undefined);
  assert.equal(at('«Осторожно – любовь» | Трейлер | KION', '2024-02-12T00:00:00Z'), undefined);
