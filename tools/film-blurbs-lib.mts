// Обрезка вступления статьи Википедии о фильме для «Сюжета» (18.10, tools/film-blurbs.mts; проверка —
// tools/film-blurbs-test.mts). Текст берём дословно, как у книг (tools/book-blurbs.mts), — только выбираем предложения:
//   • справка в начале (««Не шуршать!» — советский мультфильм, выпущенный в 1984 году киностудией Беларусьфильм.»)
//     в карточке и так есть (вид, год, режиссёр) — её снимаем; оставляем, только если в ней же сказано, о чём фильм
//     («… фильм 1967 года о поэте Александре Пушкине в последние годы его жизни»);
//   • премии, фестивали, съёмки, роли, музыка, премьера, «фильм не сохранился» — не сюжет, снимаем;
//   • списки (водевили спектакля, премии через двоеточие) — снимаем;
//   • 1–3 предложения, не длиннее MAX знаков.
// Во вступлении сюжета нет — нужен первый абзац раздела «Сюжет» (`{ need: 'plot' }`; дальше первого абзаца — спойлеры
// концовки). Нет и его — статья-заготовка («… — мультфильм 1975 года»), описание не берём.
export type FilmBlurbResult = { text: string; from: 'intro' | 'plot' } | { skip: string } | { need: 'plot' };

export const MAX = 500;
const MAX_SENTENCES = 3;

// сокращения, после которых точка — не конец предложения
const ABBR = new Set(['г', 'гг', 'им', 'т', 'д', 'е', 'н', 'п', 'ок', 'св', 'р', 'род', 'ум', 'пр', 'см', 'др', 'ст', 'ул', 'проф', 'акад',
  'вып', 'реж', 'сб', 'тыс', 'млн', 'млрд', 'руб', 'долл', 'англ', 'нем', 'франц', 'фр', 'итал', 'исп', 'лат', 'латыш', 'лит', 'эст',
  'монг', 'груз', 'арм', 'азерб', 'укр', 'белор', 'бел', 'каз', 'узб', 'тат', 'кирг', 'тадж', 'туркм', 'молд', 'рум', 'польск', 'чеш',
  'яп', 'кит', 'кор', 'фин', 'венг', 'швед', 'норв', 'дат', 'ивр', 'осет', 'букв', 'рус', 'мин', 'сек', 'ч', 'с', 'л', 'вв', 'в', 'нар']);
/** Предложения абзаца: граница — . ! ? … перед заглавной (или кавычкой, цифрой); не после сокращения и инициала. */
export function sentences(par: string): string[] {
  const out: string[] = [];
  let from = 0;
  const re = /([.!?…]+)(["»”)]*)\s+(?=["«„(]?[\p{Lu}0-9])/gu;
  for (let m: RegExpExecArray | null; (m = re.exec(par));) {
    const before = par.slice(from, m.index);
    // внутри кавычек («Беслан. Матери») — не граница
    if ((before.match(/«/g)?.length ?? 0) > (before.match(/»/g)?.length ?? 0) + (m[2].match(/»/g)?.length ?? 0)) continue;
    const word = /(\p{L}+)$/u.exec(before)?.[1] ?? '';
    // «А. А. Шибаева», «И. Грековой» — инициал; «1977 г. Премьера» — сокращение, лучше склеить, чем разрезать
    if (m[1] === '.' && !m[2] && (/^\p{Lu}$/u.test(word) || ABBR.has(word.toLowerCase()))) continue;
    out.push(par.slice(from, m.index + m[1].length + m[2].length).trim());
    from = m.index + m[0].length;
  }
  const rest = par.slice(from).trim();
  if (rest) out.push(rest);
  return out.filter(Boolean);
}

// иноязычное название в скобках: «(латыш. «Lielā Jaungada nakts»)», «(англ. Search for the Great Apes)»
// и любая скобка с сокращением языка («(пол. …», «(болг. …», «(др.-греч. …»): иначе точка сокращения режет предложение
const FOREIGN = /\s*\((?:[^()]*?[\s;,-])?\p{Ll}{2,8}\.\s[^()]*\)/gu;
export const tidy = (t: string): string => t.replace(/\{\{[\s\S]*$/, '').replace(FOREIGN, '').replace(/\s+([,.;:!?])/g, '$1').replace(/[ \t]{2,}/g, ' ').trim();

/** Справка: ««Название» — [советский …] мультфильм/фильм …» — первое предложение с тире и видом фильма. */
const KIND = /(?:фильм|мультфильм|мультипликац|короткометраж|полнометраж|кинолент|лента|драма|комеди|мелодрам|трагикомед|боевик|триллер|вестерн|мюзикл|спектакл|альманах|киноальманах|цикл|сериал|телефильм|документальн|киноочерк|киноповест|экранизац|киножурнал|агитпроп|кинокартин|картина)/iu;
export const isReference = (s: string): boolean => {
  const dash = s.search(/\s[—–-]\s/u);
  return dash >= 0 && dash < 160 && KIND.test(s.slice(dash));
};
/** Справка, в которой сказано, о чём фильм: «… о поэте …», «… посвящённый истории …», «… рассказывающий о …». */
const TOPIC = /(?:\s|\()(?:о|об|обо|про)\s+(?!том\s+же)\p{L}|посвящ[её]нн|рассказыва|повеству|описыва|показыва|история\s+(?:о|об|про)\s/iu;

/** Не сюжет, наверняка: премии и фестивали, прокат и показ, судьба плёнки, роли и музыка, зрители и критика. */
const HARD = new RegExp([
  'преми(?:я|и|ю|ей|ям|ями|ях)(?!\\p{L})', '(?<!\\p{L})приз(?:ы|а|ов|ом|ами|ах)?(?!\\p{L})', 'фестивал', 'номинир', 'номинац', 'лауреат', 'награ[дж]', 'удосто',
  'конкурс', 'прокат', '(?<!\\p{L})сбор(?:ы|ов|ах)?(?!\\p{L})', 'бюджет', 'кассов', 'съ[её]м(?:к|ок)', 'премьер', 'телеканал', 'телеэкран', 'эфир', '(?<!\\p{L})DVD', 'YouTube',
  'выш(?:ел|ла|ли)\\s+(?:также|на\\s+(?:экран|DVD|видео)|в\\s+(?:прокат|эфир|свет))', 'выход\\s+(?:фильма|состоял)', 'выходит\\s+(?:документальн|фильм|на\\s+экран)',
  'вош(?:ёл|ел|ла|ли)\\s+в\\s', 'впервые\\s+(?:показан|транслир)', 'транслирова', 'демонстрир', 'не\\s+сохранил', 'сохранил(?:ся|ась|ись)', 'утрач', 'утерян', 'реставр',
  'оцифр', 'восстановлен', 'озвуч', '(?<!\\p{L})рол(?:ь|и|ей|ях)(?!\\p{L})', 'в\\s+ролях', 'исполн(?:ил|ял|ен)', 'музык[аи](?!\\p{L})', 'композитор', 'песн(?:я|и)\\s+(?:на\\s+стихи|написан)',
  'оператор', 'художник[\\s-]+постановщик', 'цветокоррекц', 'рейтинг', 'критик(?:и|ов|ами)?(?!\\p{L})', 'зрител[еья]', '(?<!\\p{L})опрос', 'занял[аи]?\\s+\\S+\\s+место',
  'хронометраж', 'продолжительност', '\\d+\\s*(?:-\\s*)?минут', '(?<!\\p{L})верси(?:я|и|ю|ей|ях)(?!\\p{L})', 'выложен', 'перевод', 'дубляж', 'состоял(?:ся|ась|ись)',
  'презентац', 'изъят', 'смотреть\\s+детям', 'возраст(?:а|ные)?\\s+(?:ограничени|зрител)', 'не\\s+следует\\s+путать', 'заставк', 'теглайн', 'слоган', 'выставк', 'интервью',
].join('|'), 'iu');
/** Не сюжет, но рядом с ним бывает («документальный фильм, снятый Заркой Наваз, о попытках…»): съёмка, авторы, источник,
 *  место в цикле. Предложение с ними берём, только если в нём же сказано, о чём фильм. */
const SOFT = new RegExp([
  '(?<!\\p{L})снял(?:а|и)?(?!\\p{L})', 'сним(?:ал|ал[аио]|ает|ают)', '(?:от)?снят(?:ый|ая|ое|ые|ого|ой|ом|ых|а|о|ы)?(?!\\p{L})', 'выпущен', 'режисс[её]р', 'сценари', 'сценарн',
  'студи[ия]', 'киностуди', 'Союзмультфильм', 'экранизац', 'экранизир', 'адаптац', 'по\\s+мотивам', 'по\\s+одноим[её]нн',
  'по\\s+(?:сказке|рассказу|рассказам|повести|роману|романам|пьесе|стихотворению|поэме|сценарию)', 'альманах', 'сборник', 'выпуск(?!ник)', '(?<!\\p{L})сери(?:я|и|ю|ей|ях)(?!\\p{L})',
  '(?<!\\p{L})сезон', '(?<!\\p{L})цикл(?:а|е|у|ом)?(?!\\p{L})', 'трилоги', 'ремейк', 'продолжени', 'является\\s+(?:частью|первым|вторым|третьим|последним|одним)', 'другое\\s+название',
  'также\\s+известен', 'встречается\\s+под\\s+названием', 'альтернативное\\s+название', 'дебют', 'произвед[её]н', '(?<!\\p{L})показ(?!ыва)', 'программ', 'производств', 'продюсер',
  'чёрно-бел', 'цветн(?:ой|ая)\\s+(?:верси|вариант)', 'курсов(?:ой|ая)\\s+работ', 'дипломн', 'ВГИК', 'Высш(?:их|ие)\\s+(?:режисс|курс)', 'в\\s+основу\\s+(?:фильма|мультфильма)\\s+легл',
  'оригинальн(?:ый|ом)\\s+(?:рассказ|вариант)', 'основан[аоы]?\\s+на\\s', 'в\\s+основе\\s+(?:фильма|мультфильма|сюжета)\\s+(?:лежит|лежат)?\\s*(?:текст|рассказ|повест|сказк|роман|пьес|песн|стих|миниатюр|реальн)', 'концерт', 'записан', '(?<!\\p{L})диск',
].join('|'), 'iu');
/** О чём фильм: «рассказывает о…», «посвящён…», «действие происходит…», «главный герой…», «драма о…». */
const PLOT = /рассказыва|повеству|о\s+том,?\s+(?:как|что|почему|кто)|посвящ[её]н|в\s+основе\s+сюжета|по\s+сюжету|сюжет(?:\s+(?:фильма|мультфильма|ленты|картины))?\s+(?:строится|разворачива|повеству|рассказыва|посвящ|вращается|сосредоточен|построен)|действие\s+(?:\p{L}+\s+){0,2}(?:происходит|разворачивается|развивается|начинается)|главн(?:ый|ая|ые|ого|ой|ым|ыми)\s+геро|геро(?:й|иня|и|ями)\s+(?:фильма|мультфильма|ленты|картины|истории)|о\s+приключениях|описыва|изобража|(?:(?:мульт)?фильм[аеу]?|лент[аеуы]|картин[аеуы]|рассказ[аеу]?|притч[аеиу]|сказк[аеиу]|повест[ьи]|истори[яиюей]|хроник[аеиу]|очерк[аеу]?|зарисовк[аеиу]|комеди[яиюей]|драм[аеуы]|мелодрам[аеуы]|трагикомеди[яиюей]|фантази[яиюей]|байк[аеиу]|новелл[аеуы]|легенд[аеуы]|стихотворени[яею]|поэм[аеуы])(?:-\p{L}+)?(?:\s+[\p{L}.\-«»]+){0,4}?,?\s+(?:о|об|обо|про)\s+\p{L}/iu;
const SUBJECT_PLOT = /^(?:Фильм|Мультфильм|Лента|Картина|Цикл|Сериал|Мини-сериал|Телесериал|Мультсериал|Альманах)\s+(?:рассказыва|повеству|посвящ)/u;
/** Выход фильма, награды, роли — в «Сюжете» их тоже не берём. */
const RELEASE = /содержание\s+(?:фильма\s+)?не\s+установлен|содержание\s+(?:\p{L}+\s+)?известно\s+(?:из|по)|пьеса\s+пользовал|пользовал(?:ся|ась)\s+(?:большим\s+)?успех|сюжет\s+(?:фильма\s+)?неизвест|премьер|прокат|фестивал|преми(?:я|и|ю|ей|ям|ями|ях)(?!\p{L})|(?<!\p{L})приз(?:ы|а|ов|ом|ами|ах)?(?!\p{L})|номинир|номинац|лауреат|съ[её]м(?:к|ок)|дублир|редакци[яи]\s+фильма|телеканал|(?<!\p{L})DVD|не\s+сохранил|утрач|критик(?:и|ов|ами)?(?!\p{L})|(?:играть|сыграл[аи]?|исполня(?:ет|ла|л))\s+рол|(?<!\p{L})в\s+ролях/iu;
const MIDWAY = /^(?:Теперь|Тогда|Потом|Затем|Вскоре|После\s+этого|А|Но|И|Однако|Тем\s+временем|Наконец|Он|Она|Оно|Они|Его|Её|Их)(?!\p{L})/u;
export const isPlot = (s: string): boolean => PLOT.test(unquoted(s));
export const isMeta = (s: string): boolean => HARD.test(s) || SOFT.test(s);
/** Развязка — спойлер: «В конце фильма…», «В финале…» */
const FINALE = /^(?:В\s+(?:конце|финале|итоге|конечном\s+итоге|развязке)|Наконец|Закончится|Фильм\s+(?:заканчивается|завершается)|Заканчивается)(?!\p{L})/u;
const FINALE_ANY = /(?:истори[яи]|фильм|мультфильм|сюжет|действие)\s+(?:заканчивается|завершается|кончается)|в\s+финале\s+(?:фильма|мультфильма)/iu;
export const isFinale = (s: string): boolean => FINALE.test(s) || FINALE_ANY.test(s);
/** Без цитат в кавычках: название «Не про тебя ли эта книжка?» — не «о чём фильм». */
const unquoted = (s: string): string => s.replace(/«[^«»]*»/g, '«»');

/** Абзацы без списков: строка, кончающаяся двоеточием, и строки-пункты под ней (без точки в конце) — не текст. */
function paragraphs(text: string): string[] {
  const out: string[] = [];
  let list = false;
  for (const raw of text.split(/\n+/)) {
    const p = raw.trim();
    if (!p) continue;
    // строка-указатель над статьёй: «Эта статья — о российском фильме 1916 года…», «Не следует путать с…»
    if (/^(?:Эта статья|Этот (?:фильм|мультфильм) не следует|Не следует путать|Не путать|Запрос «|См\.\s)/u.test(p)) continue;
    if (/:$/.test(p)) { list = true; continue; }
    // пункт списка — без конца предложения; первый абзац (справка без точки, «Знамя партии») — не пункт
    if (list && !/[.!?…»"]$/.test(p)) continue;
    if (out.length && p.length < 60 && !/[.!?…]$/.test(p)) continue;
    list = false;
    out.push(p);
  }
  return out;
}

/** Не больше MAX_SENTENCES предложений и MAX знаков: длинное первое — по слову с многоточием. */
function fit(ss: string[]): string {
  let t = '';
  for (const s of ss.slice(0, MAX_SENTENCES)) {
    const next = t ? `${t} ${s}` : s;
    if (next.length > MAX) {
      if (!t) t = `${s.slice(0, MAX).replace(/[\s,;:—–-]+\S*$/u, '')}…`;
      break;
    }
    t = next;
  }
  return t.replace(/(?<![.!?…»")])$/u, '.');
}

/** Вступление (и, если уже есть, первый абзац «Сюжета», null — раздела нет) → описание, отсев или «нужен „Сюжет“». */
export function filmBlurb(intro: string, plot: string | null | undefined): FilmBlurbResult {
  const ss = paragraphs(intro).map(tidy).flatMap(sentences).filter(Boolean);
  if (!ss.length) return { skip: 'пусто' };
  const ref = isReference(ss[0]);
  const keepRef = ref && TOPIC.test(unquoted(ss[0].slice(ss[0].search(/\s[—–-]\s/u))));
  // сюжет во вступлении: предложение «о чём фильм» без премий и проката — и следом за ним такие, где нет ни того, ни
  // другого («Цикл рассказывает о приключениях котёнка… | Гав постоянно попадает в нелепые ситуации…»)
  const story: string[] = [];
  let open = false;
  for (const s of ss.slice(ref ? 1 : 0)) {
    // «Цикл рассказывает о…», «Мини-сериал посвящён…» — слово из SOFT здесь подлежащее, а не справка
    const lead = isPlot(s) && !HARD.test(s) && (!SOFT.test(s) || SUBJECT_PLOT.test(s)) && !/^(?:В|С|К|До|После)\s+\d{4}/u.test(s);
    // «Он знакомит с главными героями…» — местоимение без того, к кому оно относится, — не начало описания
    if (!open && /^(?:Он|Она|Оно|Они|Это|Эта|Этот|Эти|Его|Её|Их|Там|Тогда|Также|Кроме\s+того)(?!\p{L})/u.test(s)) { open = false; continue; }
    // продолжение — без справки, без дат выпуска («Алексей Иванов задумал проект в 2006 году»)
    const next = open && !isMeta(s) && !/(?:1[89]|20)\d{2}(?:\s*[-—–]\s*\d{2,4})?\s+год/u.test(s) && !/^(?:Фильм|Мультфильм|Лента|Картина)(?!\p{L})/u.test(s);
    open = (lead || next) && !isFinale(s) && s.length >= 25;
    if (open) story.push(s);
  }
  if (story.length) return { text: fit(keepRef ? [ss[0], ...story] : story), from: 'intro' };
  if (plot === undefined) return { need: 'plot' };
  if (plot) {
    // и в «Сюжете» бывает справка: «По мотивам рассказов…», «Экранизация романа…», «В 1959 году фильм был дублирован…»
    // (в начале абзаца; дальше SOFT — часть сюжета: «Композитор Кеша…», «В цирке Волк-зритель…» — поэтому здесь и
    // список «не сюжета» уже: только выход фильма, награды и роли)
    const all = paragraphs(plot).map(tidy).flatMap(sentences).filter((x) => !isFinale(x) && !RELEASE.test(x));
    // и не с полуслова: «Теперь уже… остаются не от козлика, а от бабушки», «А сам козлик…» — это середина, а то и развязка
    const ps = all.slice(Math.max(0, all.findIndex((x) => (!SOFT.test(x) || isPlot(x)) && !MIDWAY.test(x))));
    if (ps.length && all.every((x) => (SOFT.test(x) && !isPlot(x)) || MIDWAY.test(x))) ps.length = 0;
    if (ps.length && ps.join(' ').length >= 40) return { text: fit(ps), from: 'plot' };
  }
  // ни сюжета во вступлении, ни раздела: справка «о чём» — лучше, чем ничего, если в ней есть что сказать
  if (keepRef) {
    const about = ss[0].slice(ss[0].search(TOPIC));
    if (about.length >= 25) return { text: fit([ss[0]]), from: 'intro' };
  }
  return { skip: ss.length === 1 && ref ? 'заготовка' : 'нет сюжета' };
}

/** Первый абзац раздела «Сюжет» (или «Содержание», «Синопсис») из статьи целиком (extracts, exsectionformat=wiki). */
export function plotSection(full: string): string | null {
  const m = /^==\s*(?:Сюжет|Содержание|Синопсис|Сюжет (?:мультфильма|фильма)|Фабула)\s*==\s*$/mu.exec(full);
  if (!m) return null;
  const rest = full.slice(m.index + m[0].length).replace(/^\s+/, '');
  // до следующего заголовка; подраздел внутри «Сюжета» — тоже граница
  const body = rest.split(/^=+[^=\n]+=+\s*$/mu)[0].trim();
  return body.split(/\n+/).map((s) => s.trim()).find((s) => s.length >= 40 && !/:$/.test(s)) ?? null;
}

// шаблоны, у которых в тексте остаётся первый параметр: {{iw|Ру|En|…}}, {{nobr|…}}, {{lang-en|…}}
const KEEP_FIRST = /^(?:iw|не переведено(?:\s*\d)?|nobr|nowrap|s|comment|abbr|lang-[a-z-]+|начало цитаты|cite|не\s*переведено|translate|ok|нп\d?|без переносов|tooltip|sfn-текст)$/iu;
/** Вики-текст абзаца → простой текст: сноски, комментарии, картинки и шаблоны долой, ссылки — их текстом. */
export function wikiPlain(w: string): string {
  let t = w.replace(/<!--[\s\S]*?-->/g, '')
    .replace(/<ref[^>]*\/>/giu, '').replace(/<ref[^>]*>[\s\S]*?<\/ref>/giu, '');
  // шаблоны — изнутри наружу
  for (let guard = 0; /\{\{/.test(t) && guard < 20; guard++) {
    t = t.replace(/\{\{([^{}]*)\}\}/g, (_, body: string) => {
      const [name, ...args] = body.split('|');
      const first = args.find((x) => !/^\s*[\p{L}\d_-]+\s*=/u.test(x));
      return KEEP_FIRST.test(name.trim()) && first ? first.trim() : '';
    });
  }
  // шаблон, не закрытый в этом абзаце («{{книга» на несколько строк) — до конца
  t = t.replace(/\{\{[\s\S]*$/, '');
  // картинки и категории — с вложенными ссылками в подписи
  t = t.replace(/\[\[(?:Файл|File|Изображение|Image|Категория|Category):(?:[^[\]]|\[\[[^[\]]*\]\])*\]\]/giu, '');
  t = t.replace(/\[\[([^[\]|]*)\|([^[\]]*)\]\]/g, '$2').replace(/\[\[([^[\]]*)\]\]/g, '$1')
    .replace(/\[https?:\/\/\S+\s+([^\]]+)\]/g, '$1').replace(/\[https?:\/\/[^\]]+\]/g, '')
    .replace(/'{2,}/g, '').replace(/<br\s*\/?>/giu, ' ').replace(/<\/?[a-z][^>]*>/giu, '')
    .replace(/&nbsp;/g, ' ').replace(/&mdash;/g, '—').replace(/&ndash;/g, '–').replace(/&laquo;/g, '«').replace(/&raquo;/g, '»').replace(/&amp;/g, '&')
    .replace(/́/g, '').replace(/[ \t]+/g, ' ').replace(/ ([,.;:!?)])/g, '$1').replace(/\( /g, '(').replace(/\(\s*\)/g, '');
  return t.trim();
}

/** Первый абзац раздела «Сюжет» из вики-текста статьи (prop=revisions): абзацы вики-текста — через пустую строку. */
export function plotFromWikitext(wiki: string): string | null {
  const m = /^==\s*(?:Сюжет|Содержание|Синопсис|Сюжет (?:мультфильма|фильма)|Фабула)\s*==\s*$/mu.exec(wiki);
  if (!m) return null;
  const body = wiki.slice(m.index + m[0].length).split(/^=+[^=\n]+=+\s*$/mu)[0];
  for (const raw of body.split(/\n\s*\n/)) {
    // строки-служебные: картинка, шаблон-врезка, таблица, список, отступ
    const lines = raw.split('\n').filter((l) => !/^\s*(?:\[\[(?:Файл|File|Изображение|Image):|\{\{|\}\}|\||[*#:;]|\{\|)/iu.test(l));
    const p = wikiPlain(lines.join(' '));
    if (p.length >= 40 && !/:$/.test(p)) return p;
  }
  return null;
}
