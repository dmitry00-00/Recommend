// Свои книги каталога (27.10, решение владельца «завести своим ключом»): художественные книги, которых нет ни в
// Wikidata, ни в Open Library, — в основном современная русская проза. Ключ `own:` — 8 знаков sha1 от titleKey(название)
// и фамилии первого автора (src/lib/keys.ts); записан здесь явно и при правке названия не меняется. Карточки собирает
// tools/build-book-base.mts. Год — первой публикации (у переводной — оригинала); не нашёлся — нет. Описание (`blurb`) —
// свой пересказ по страницам издательств и рецензиям, не аннотация издательства; в «Сюжете» оно идёт без ссылки.
// Появится элемент Wikidata — строку перенести в .cache/book-lists/ с `qid`, разметку и желания — на ключ `wd:`.
//   «По ту сторону» (Букмейт, 2020–2021) — серия рассказов, вышедших отдельными книгами: «Общайся, живи!», «Квартирай»,
//   «Отец ждёт», «Умрец», «На каникулах», «Целое».
export type OwnBook = { own: string; title: string; originalTitle?: string; authors: string[]; year?: number; blurb?: string; why: string };
export const OWN_BOOKS: OwnBook[] = [
  {"own":"1be721a6","title":"Саспыга","authors":["Карина Шаинян"],"year":2025,"blurb":"В алтайском конном походе туристка Ася отбивается от группы, и повар Катя, отыскав её, вынуждена идти дальше вместе с ней. Катю тревожат неестественно покорная лошадь и смутные воспоминания об охоте на саспыгу — мифического зверя с самым вкусным мясом на свете.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"3e76061c","title":"Общайся, живи!","authors":["Алексей Сальников"],"year":2020,"blurb":"Каменщик и его жена-маникюрша берут непосильную ипотеку, чтобы переехать из однушки. Новая квартира оказывается обшарпанной, ссоры из-за денег гасятся шутками, а в договоре обнаруживается странный пункт о смертности заёмщика, который не даёт мужу покоя.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"f810c810","title":"Квартирай","authors":["Евгения Некрасова"],"blurb":"Зина уезжает из моногорода, где семейные драмы повторяются по кругу, и ищет «жизнь-жизнь»: меняет работы, мужчин и города. В Москве она покупает свой «квартирай», где ни от кого не зависит, и знакомится с продавцом лампочек Сашей, пережившим теракт.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"c8ae313e","title":"Дуа за неверного","authors":["Егана Джаббарова"],"year":2024,"blurb":"Рассказчица пытается осмыслить гибель сводного брата Сергея. Через его судьбу проступает Россия конца 1990-х — начала 2000-х с межэтническим напряжением, бедностью и борьбой за выживание, а разговор об утрате переходит в размышления об идентичности и любви.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"e05529d5","title":"Руки женщин моей семьи были не для письма","authors":["Егана Джаббарова"],"year":2023,"blurb":"Молодая женщина из азербайджанской семьи, выросшая на Урале, рассказывает о себе через части тела: брови, рот, волосы. Каждая глава связывает её тело с родственницами, с правилами общины, с собственным бунтом и с мышечной болезнью, отнимающей силы.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"cb3af4c9","title":"Отец смотрит на запад","authors":["Екатерина Манойло"],"year":2022,"blurb":"Катя, дочь русской матери и казаха, растёт в маленьком приграничном городке Оренбургской области, где две культуры и деспотичные семейные порядки определяют её характер. После семейной трагедии она уезжает в Москву, но родные места не отпускают.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"0bf1e870","title":"Отец ждёт","authors":["Кирилл Рябов"],"blurb":"Селиванов, пьющий провинциал, ушедший из семьи, после долгого перерыва срывается в тяжёлый запой. Сквозь похмельный морок, в котором смешались ковидная тревога и мрачные происшествия, его неотступно тянет к отцу.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"e48e287c","title":"Башня тишины","authors":["Рагим Джафаров"],"year":2024,"blurb":"Слепой мошенник Руслан, выдающий себя за зороастрийского мага Шахривара, летит в Баку, чтобы встретиться с отцом, которого не видел тридцать лет, и узнать, что случилось с пропавшей сестрой. Там он попадает в семейные, криминальные и политические интриги.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"376a2090","title":"Бабушка сказала сидеть тихо","authors":["Настасья Реньжина"],"year":2024,"blurb":"Баба Зоя живёт одна в глухой деревне, и соседи считают, что она тронулась умом и верит в домового. На деле в её шкафу обитает косматое существо, не умеющее говорить: она зовёт его Купринькой, кормит, иногда выпускает и строго велит сидеть тихо.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"aa162db2","title":"Сестрёнка","authors":["Кристина Гептинг"],"year":2019,"blurb":"У Юли внешне всё налажено — психотерапия, фитнес, правильное питание, — но справиться с детской травмой она не может. Роман о семье, где насилие считается нормой, построен как многоголосая исповедь: каждый из близких рассказывает свою версию событий.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"5ef6ad7d","title":"Папуля","originalTitle":"Daddy","authors":["Эмма Клайн"],"year":2020,"blurb":"Десять рассказов о людях, чья устойчивая жизнь даёт трещину под давлением желания, власти, стыда и семейных конфликтов. Отец забирает сына из интерната после вспышки насилия, няня скрывается после скандала в семье знаменитостей; в каждой истории рядом мужская фигура.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"6ae8d1f3","title":"Котлантида","authors":["Анна Старобинец"],"year":2011,"blurb":"Рыжий кот Багет — потомок котлантов, жителей затонувшего острова, и унаследовал от них умение путешествовать во времени. Он отправляется в далёкое прошлое, на Котлантиду, чтобы вернуть котам их девять жизней.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"687b4a67","title":"Страна Хороших Девочек","authors":["Анна Старобинец"],"year":2009,"blurb":"Полине Петровой родные постоянно твердят, что хотели бы хорошую девочку. После новогодней истерики её место дома занимает идеальная Хорошая Девочка, а саму Полину забирают на перевоспитание в Страну Хороших Девочек.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"7838ce86","title":"Умрец","authors":["Саша Степанова"],"blurb":"Вера тяжело больна. Пока свекровь деловито хлопочет о будущих похоронах, а муж ей изменяет, героиня, оказавшись рядом со смертью, по-новому смотрит на своих близких.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"3d0d6535","title":"На каникулах","authors":["Антон Секисов"],"year":2020,"blurb":"Рассказчик, привыкший считать себя гражданином мира, после смерти бабушки возвращается в родной город. Похоронные хлопоты и встречи с прошлым неожиданно показывают ему, как сильно он привязан к своим старикам.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"ed87ff67","title":"Целое","authors":["Артём Серебряков"],"blurb":"Рассказчик вступает в схватку с инфернальным червём, поселившимся в голове его брата. Фантасмагорическая история о болезни и о том, как близость смерти меняет отношения двух братьев.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"e3e5ba8b","title":"Пятно","authors":["Анна Пестерева"],"year":2024,"blurb":"Настя живёт в маленьком городе, дружит с бывшим мужем и мечтает о хорошей удалённой работе. Однажды зимой она пропадает на три с половиной недели и, вернувшись, никому не говорит, где была. Забыть то время не выходит: чтобы отпустить его, придётся туда вернуться.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"52bcafd9","title":"Память по женской линии","authors":["Татьяна Алфёрова"],"year":2023,"blurb":"Три цикла: семейная хроника женщин одного рода, которая обрастает преданиями от Рыбинска начала XX века до послевоенного Ленинграда; «Неомифологический словарь» о героях мифов среди нынешних людей; почти автобиографические «Рассказы, написанные осенью».","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"85d55b9f","title":"Дети в гараже моего папы","authors":["Анастасия Максимова"],"year":2024,"blurb":"Психологический роман о герое, который узнаёт, что его отец — серийный убийца. Ему приходится искать ответ на вопрос, как продолжать жить с этим знанием и кем считать себя, будучи сыном такого человека.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"6157d90c","title":"Уклады","authors":["Денис Осокин","Антон Секисов","Ксения Буржская","Ольга Птицева","Анна Шипилова","Дмитрий Захаров","Ислам Ханипаев","Егана Джаббарова","Даша Благова","Илья Мамаев-Найлз","Марина Кочан","Екатерина Манойло","Евгения Некрасова"],"year":2025,"blurb":"Тринадцать писателей, пишущих по-русски, рассказывают об укладах своих культур. Рассказы разделены на «События» — от рождения до смерти, взросление, выбор профессии, свадьба — и «Явления»: сон и явь, зима и лето, ночь и день.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"0e895483","title":"Старые и новые открытки с того света","originalTitle":"Cartoline dai morti","authors":["Франко Арминио"],"year":2010,"blurb":"Короткие, в несколько строк, послания от умерших, словно открытки с того света. Каждая фиксирует последнее мгновение жизни — вдох, взгляд, желание, жест; ритмизованная проза балансирует между стихотворением и афоризмом.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"89156b7d","title":"Приключения Котобоя","authors":["Андрей Усачёв"],"year":2012,"blurb":"На далёком севере есть деревня Котьма, где живут одни коты. Они строят из старой лодки парусную яхту «Котобой» и отправляются в море ловить не мелкую рыбёшку, а целого кита.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"222aaf01","title":"Путешествие в Мышляндию","authors":["Андрей Усачёв"],"year":2010,"blurb":"Книга-путешествие по вымышленной стране мышей: читатель знакомится с мышиной историей, сказками и поэзией, а заодно с мышиной музыкой от рока и джаза до романса и попсы. Герои стихов и сказок — мышата, взрослые грызуны и, конечно, коты.","why":"Яндекс Книги @SbSubzero 27.10"},
  {"own":"e4535b75","title":"Моня и Веня: котики, которых любят","authors":["Марта Кетро"],"blurb":"Два ухоженных котика, Моня и Веня, живут с мамой в солнечном южном городе у моря. На людях они ведут себя благопристойно, но стоит маме отвернуться, начинается их тайная жизнь, полная приключений, открытий и даже опасностей.","why":"Яндекс Книги @SbSubzero 27.10"},
];
