// Опознание названий в просьбах Telegram (18.10, tools/tg-asks-match.mts): случаи из замера 17.10 и разбора пар 18.10.
//
//   npx tsx tools/tg-asks-test.mts
//
// Карточки — как в справочнике (известность — разделы Википедии, как в .cache/fame-wd.json на 18.10), счёт обычных слов —
// как в корпусе каналов о кино (tools/telegram-channels.json, 69 703 поста).
import assert from 'node:assert/strict';
import { askKind, findTitles, kindNear, matcher, negated, offered, strongForm, threadKinds, threadKey } from './tg-asks-match.mts';
import type { IndexedWork } from './works-index.mts';
import type { WorkCard } from '../src/types/tmdf.ts';

const fame: Record<string, number> = {};
const w = (key: string, title: string, year: number, type: 'film' | 'series' | 'book', score: number, creators: string[] = [], names: string[] = []): IndexedWork => {
  fame[key] = score;
  return { key, work: { id: key, type, title, year, creators } as unknown as WorkCard, names: [title, ...names] };
};
const index: IndexedWork[] = [
  w('imdb:tt9813792', 'Извне', 2022, 'series', 28),
  w('tmdb:14510', 'Извне', 1986, 'film', 20, ['Стюарт Гордон']),
  w('wd:Q5505365', 'Извне', 1934, 'book', 0, ['Говард Филлипс Лавкрафт']),
  w('tmdb:146233', 'Пленницы', 2013, 'film', 72, ['Дени Вильнёв']),
  w('tmdb:85494', 'Пленницы', 1952, 'film', 6),
  w('imdb:tt0386676', 'Офис', 2005, 'series', 84),
  w('imdb:tt0290978', 'Офис', 2001, 'series', 42),
  w('tmdb:3782', 'Жить', 1952, 'film', 40, ['Kurosawa']),
  w('tmdb:31439', 'Жить', 1994, 'film', 23, ['Чжан Имоу']),
  w('tmdb:760099', 'Жить', 2022, 'film', 20),
  w('tmdb:694823', 'Пугало', 2020, 'film', 10),
  w('tmdb:31587', 'Пугало', 1973, 'film', 18),
  w('tmdb:2061', 'Дилер', 1996, 'film', 24, ['Николас Виндинг Рефн']),
  w('tmdb:93', 'Анатомия убийства', 1959, 'film', 43),
  w('tmdb:13', 'Форрест Гамп', 1994, 'film', 128),
  w('imdb:tt0411008', 'Остаться в живых', 2004, 'series', 94),
  w('tmdb:10625', 'Дрянные девчонки', 2004, 'film', 59),
  w('tmdb:673593', 'Дрянные девчонки', 2024, 'film', 24),
  w('tmdb:3170', 'Бэмби', 1942, 'film', 113),
  w('tmdb:171944', 'Бэмби', 2013, 'film', 6),
  w('imdb:tt10048342', 'Ход королевы', 2020, 'series', 60),
  w('tmdb:77338', '1+1', 2011, 'film', 15),
  w('tmdb:117', 'Неприкасаемые', 1987, 'film', 55),
  w('tmdb:77338b', 'Неприкасаемые', 2011, 'film', 15),
  w('tmdb:44214', 'Чёрный лебедь', 2010, 'film', 49),
  w('tmdb:29882', 'Чёрный лебедь', 1942, 'film', 23),
  w('tmdb:777', 'Фотограф', 1992, 'film', 14),
  w('tmdb:888', 'Кавардак', 1949, 'film', 4),
  w('tmdb:844135', 'Шарлотта', 2021, 'film', 5),
  w('tmdb:1', 'Одиссея', 2026, 'film', 178, [], ['The Odyssey']),
  w('tmdb:2', 'Одиссея', 2016, 'film', 15),
  w('imdb:tt7', 'Беспринципные', 2020, 'series', 3),
];
const alt = { 'tmdb:13': ['Форест Гамп'], 'imdb:tt0411008': ['Лост', 'Lost'], 'tmdb:888': ['Хелтер-Скелтер'] };
const common: Record<string, number> = { жить: 362, офис: 125, извне: 16, пугало: 10, одиссея: 33, связь: 203 };
const match = matcher(index, { alt, fame: (c) => fame[c.id] ?? 0, common: (x) => common[x] ?? 0 });
const key = (title: string, type: string | undefined, text: string, extra: Partial<Parameters<typeof match>[1]> & { year?: number; wy?: number; original?: string } = {}) =>
  match({ title, ...(type ? { type } : {}), ...(extra.wy ? { year: extra.wy } : {}), ...(extra.original ? { original: extra.original } : {}) }, { text, ...extra }).key;

// тёзки без года — по известности: «Пленницы» Вильнёва, «Бэмби» Диснея, «Дрянные девчонки» 2004-го
assert.equal(key('Пленницы', 'film', 'Пленницы смотрела, пожары видимо посмотрю'), 'tmdb:146233');
assert.equal(key('Бэмби', 'cartoon', 'Бэмби 2,5 шаришь!'), 'tmdb:3170');
assert.equal(key('Дрянные девчонки', 'film', 'Дрянные девчонки 💘'), 'tmdb:10625');
assert.equal(key('Чёрный лебедь', 'film', '«Черный лебедь»'), 'tmdb:44214', 'ё/е и кавычки');
// равные тёзки — никого
assert.equal(key('Жить', 'film', 'а ещё «Жить»', {}), 'tmdb:3782', 'громче вдвое — берём');
// альтернативные названия: «Форест Гамп» (опечатка в Wikidata), «Лост»
assert.equal(key('Форест Гамп', 'film', 'Форест гамп'), 'tmdb:13');
assert.equal(key('Лост', 'series', 'посмотри ходящих мертвецов, лост, извне'), 'imdb:tt0411008');
// чужое название тихого фильма — нет: «Хелтер-Скелтер» — фильм 2012-го, а не «Кавардак» 1949-го
assert.equal(key('Хелтер-Скелтер', 'film', 'Посоветуйте фильм похожий на Хелтер-Скелтер'), undefined);
// по основам — только из двух слов: «Фотографии» — не «Фотограф»
assert.equal(key('Фотографии', 'film', 'Фотографии, Служанка'), undefined);
// второе название в скобках
assert.equal(key('Неприкасаемые', 'film', 'Неприкасаемые (1+1) Стабильно раз в год пересматриваю'), 'tmdb:77338');
// режиссёр в тексте — и латиницей, и год модели, которого в тексте нет («Дилер» Рефна — не 1988)
assert.equal(key('Жить', 'film', 'Жить (Куросава)'), 'tmdb:3782');
assert.equal(key('Дилер', 'film', 'Первые работы Рефна наконец заценил ("Дилер 1-2")', { wy: 1988 }), 'tmdb:2061');
assert.equal(key('Дилер', 'film', 'Дилер 1988 года', { wy: 1988 }), undefined, 'год в тексте — модели верим');

// Извне: ветка «посоветуйте фильм на ночь», модель зовёт фильмом, но один из ответов — «оба сериала»
const parent = 'посоветуйте фильм на ночь';
const thread = [{ text: parent, titles: [] }, { text: 'извне', titles: ['Извне'] },
  { text: 'Извне и ОСД на одном уровне сняли, оба сериала одинаково хороши', titles: ['Извне', 'ОСД'] }, { text: 'короче танзи смотри извне', titles: ['Извне'] }];
const tk = threadKinds(thread);
assert.equal(tk.get(threadKey('Извне')), 'series');
assert.equal(key('Извне', 'film', 'короче танзи смотри извне', { parent, thread: tk.get(threadKey('Извне')) }), 'imdb:tt9813792');
assert.equal(key('Извне', 'film', 'короче танзи смотри извне', { parent }), 'tmdb:14510', 'без ветки модель и просьба говорят «фильм» — потому ветка и нужна');
assert.equal(key('Извне', 'film', 'короче танзи смотри извне', { parent: 'посоветуйте что посмотреть' }), undefined, 'ловушка без подтверждения');
assert.equal(key('Извне', 'series', 'посмотри ходящих мертвецов, лост, извне, сверхестественное'), 'imdb:tt9813792', 'книги не берём');

// ловушки из обычных слов — только с подтверждением
assert.equal(key('Офис', 'series', 'пусть будет офис', { parent: 'посоветуйте какой нибудь сериал в стиле осд' }), 'imdb:tt0386676');
assert.equal(key('Офис', 'series', 'пусть будет офис', { parent: 'посоветуйте фильм или сериал' }), undefined);
assert.equal(key('Офис', 'series', 'пересмотр лучших серий сериала "Офис"'), 'imdb:tt0386676');
assert.equal(key('Пугало', 'series', 'сериал пугало корейский', { parent: 'подскажите интересный фильм' }), undefined, '«сериал» рядом — фильм не берём');
assert.equal(key('Жить', 'series', 'холод жить жизнь топи фишер ира', { parent: 'посоветуйте сериал или фильм' }), undefined);
assert.equal(key('Одиссея', 'film', 'The Odyssey', { original: 'The Odyssey' }), 'tmdb:1', 'громкая, тёзка тихий');
// чужой вид: «фильм» модели при одном сериале — да («Ход королевы»); «сериал» модели при одном фильме — нет
assert.equal(key('Ход королевы', 'film', 'Ход королевы'), 'imdb:tt10048342');
assert.equal(key('анатомия убийства', 'series', 'я смотрела сериал "вскрытие покажет", анатомия убийства'), undefined);
// аниме на месте тихого фильма — нет
assert.equal(key('Шарлотта', 'anime', 'Шарлоту смотрел?'), undefined);
// сериал идёт годами: год модели — год сезона, в тексте года нет
assert.equal(key('Беспринципные', 'series', 'Беспринципные', { wy: 2026 }), 'imdb:tt7');

// текстовые сторожа
assert.equal(findTitles('у меня нехватка только времени. Похожий на этот " Время"', 'Время').length, 2);
assert.ok(strongForm('у меня нехватка только времени. Похожий на этот " Время"', 'Время'), 'второе место — в кавычках');
assert.ok(strongForm('бумажный дом, легенда об искателе, Мерлин, мышь, 5:32', 'Мышь'), 'пункт списка');
assert.ok(strongForm('мой топ (кухня, бесстыжие, оно)', 'Оно'));
assert.ok(!strongForm('А как тебе сверхъестественное?', 'Сверхъестественное'));
assert.equal(kindNear('Проект конец света, Выход 8, мини сериал Исчезнуший.', 'Выход 8'), undefined, 'сериал — про последний пункт');
assert.equal(kindNear('Посоветуйте сериал или фильм похожий на «Беспринципные»', 'Беспринципные'), undefined);
assert.equal(askKind('посоветуйте фильм на ночь'), 'film');
assert.equal(askKind('посоветуйте фильм или сериал'), undefined);
// якорь «понравилось»: отрицание и совет автора просьбы
assert.ok(negated('посоветуйте супер мега классный сериал или фильм сумерки не надо!!!', 'Сумерки'));
assert.ok(negated('быстро сериал посоветуйте , декстер , ты , менталист , не предлагайте !!!', 'Декстер'), 'отрицание на весь перечень');
assert.ok(negated('подскажите фильм кроме Титаника', 'Титаник'));
assert.ok(!negated('Мне понравился Офис, а ещё Декстер. Сумерки не надо', 'Офис'));
assert.ok(!negated('Посмотрел сериал «Захваченный рейс», мне зашло. 2 сезон про метро, не хочу смотреть', 'Захваченный рейс'), '«мне зашло» — не «не зашло»');
assert.ok(!negated('Моя дочь (ей 11), кроме Гарри Поттера вообще ничего не читает', 'Гарри Поттер'), '«кроме … ничего» — это «только»');
assert.ok(!negated('Дочь - фанатка Гарри Поттера. Посоветуйте, что кроме Гарри Поттера можно посмотреть', 'Гарри Поттер'), 'назван и без «кроме» — якорь');
assert.ok(negated('фильмы с Джилленхолом кроме «Пленницы», «Горбатая гора» и «Донни Дарко»', 'Донни Дарко'), '«кроме» на весь перечень');
assert.ok(negated('фильмы Стенли Кубрика кроме "сияние" и "заводной апельсин"', 'Сияние'));
assert.ok(offered('Посоветуйте мне фильм или сериал 😂 Посмотрите сериал Невский, если ещё не смотрели', 'Невский'));
assert.ok(!offered('Посмотрел сериал «Захваченный рейс», мне зашло', 'Захваченный рейс'));

console.log('tg-asks-test: ok');
