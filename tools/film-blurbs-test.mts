// Проверка обрезки описаний фильмов без TMDb (tools/film-blurbs-lib.mts, 18.10) на настоящих вступлениях русской
// Википедии — взяты из .cache/film-blurbs/intro.json как есть (вместе с переводами строк).
//   npx tsx tools/film-blurbs-test.mts
import assert from 'node:assert/strict';
import { filmBlurb, plotFromWikitext, plotSection, sentences, tidy } from './film-blurbs-lib.mts';

const text = (intro: string, plot?: string | null) => {
  const r = filmBlurb(intro, plot);
  assert.ok('text' in r, `ждали описание, получили ${JSON.stringify(r)}`);
  return r;
};

// 1. Заготовка: одна справка — без «Сюжета» ждём раздел, без раздела — не берём
{
  const intro = '«Не шуршать!» — советский мультфильм, выпущенный в 1984 году киностудией Беларусьфильм.';
  assert.deepEqual(filmBlurb(intro, undefined), { need: 'plot' });
  assert.deepEqual(filmBlurb(intro, null), { skip: 'заготовка' });
}

// 2. Справка, в которой сказано, о чём фильм, остаётся; за ней — предложение о действии
assert.deepEqual(text('«Гибель Пушкина» — советский чёрно-белый документально-игровой фильм 1967 года о поэте Александре Пушкине в последние годы его жизни. Действие происходит в Михайловском и Петербурге, включая события дуэли.'), {
  from: 'intro',
  text: '«Гибель Пушкина» — советский чёрно-белый документально-игровой фильм 1967 года о поэте Александре Пушкине в последние годы его жизни. Действие происходит в Михайловском и Петербурге, включая события дуэли.',
});

// 3. Справка, съёмки и сценарий — мимо; «Цикл рассказывает…» и два предложения следом — сюжет; толкования и «заявила
//    о продолжении» за пределом трёх предложений
assert.deepEqual(text('«Котёнок по имени Гав» — цикл советских мультипликационных фильмов Льва Атаманова. Заключительная серия создана после смерти Льва Атаманова Леонидом Шварцманом.\nСценарии мультфильмов написаны по одноимённым сказкам Григория Остера. Цикл рассказывает о приключениях котёнка с необычным именем Гав и его друга — щенка Шарика. Гав постоянно попадает в нелепые ситуации и находит приключения сразу, как только выходит из дома. Он уверен, что необходимо идти навстречу неприятностям, потому что старый дворовый кот ему заявил: «Котёнка с таким именем ждут одни неприятности!» Также он знает, как правильно делить сосиски, зачем нужен тайный язык и почему бояться грозы нужно вместе с другом на чердаке.\nМультсериал акцентирует внимание на настоящей дружбе, иллюстрирует заботу взрослых о маленьких и слабых. С другой стороны, существует мнение, что страшный Пёс и коварный Чёрный кот представляют взрослый мир, в то время как щенок и котёнок олицетворяют детский мир — наивный и добрый.\nВ июле 2017 года компания «Союзмультфильм» заявила о продолжении мультфильма. С тех пор никаких заявлений больше не появлялось.'), {
  from: 'intro',
  text: 'Цикл рассказывает о приключениях котёнка с необычным именем Гав и его друга — щенка Шарика. Гав постоянно попадает в нелепые ситуации и находит приключения сразу, как только выходит из дома. Он уверен, что необходимо идти навстречу неприятностям, потому что старый дворовый кот ему заявил: «Котёнка с таким именем ждут одни неприятности!»',
});

// 4. Справка и список премий через двоеточие — не сюжет
assert.deepEqual(filmBlurb('«Березовский TRIP» — документальная драма. Производство творческого объединения ДЕКАбрь, 2006.\nФильм-обладатель многих российских призов и премий:\n\nспец.приз фестиваля «Кинотеатр.doc 2007»\nофициальная премия жюри XXVIII фестиваля «Россия», 2007\nпремия Российской гильдии кинокритиков, 2007\nноминация на лучший документальный дебют года премии «Лавр 2007».\nи другие номинации.', null), { skip: 'нет сюжета' });

// 5. Иноязычное название в скобках снимается; режиссёр, сценарист, студия — не сюжет
{
  const intro = '«Большая новогодняя ночь» (латыш. «Lielā Jaungada nakts») — советский художественный фильм режиссёра Ады Неретниеце. Мелодрама по сценарию Эгонса Ливса, снятая на Рижской киностудии в 1978 году.';
  assert.equal(tidy(intro).slice(0, 60), '«Большая новогодняя ночь» — советский художественный фильм р');
  assert.deepEqual(filmBlurb(intro, null), { skip: 'нет сюжета' });
  assert.equal(tidy('«Одна июньская ночь» (пол. Noc czerwcowa) — польский телефильм 2001 года.'), '«Одна июньская ночь» — польский телефильм 2001 года.');
}

// 6. Инициалы («А. А. Шибаева») — не конец предложения
assert.equal(sentences('«И я бы мог…» — советский рисованный мультипликационный фильм, созданный по одноимённому стихотворению А. А. Шибаева на киностудии «Союзмультфильм» в 1983 году.').length, 1);

// 7. Точка внутри кавычек («Беслан. Надежда») — не граница; съёмки и герои другого фильма — мимо
{
  const intro = '«Беслан. Память» — документальный фильм режиссера Вадима Цаликова из документальной тетралогии «Граждане Беслана», «Отставной учитель», «Беслан. Надежда», «Беслан. Память».\nФильм посвящён 10-летию террористического акта в Беслане, где в сентябре 2004 года произошёл захват школы № 1. Известный российский режиссёр Вадим Цаликов впервые познакомился с ними во время съёмок фильма «Граждане Беслана» и вернулся спустя 10 лет, когда жизнь героев кардинально изменилась: многие стали студентами. Надежда Гуриева, потерявшая в теракте двоих детей, также была героиней другого фильма «Беслан. Надежда» в 2008 году. Новыми героями стали Касполат Рамонов, смотритель кладбища «Город ангелов», итальянский скульптор Рензо Венди, создавший памятник детям Беслана в Сан-Марино, журналист ARD Альбрехт Райнхардт и преподаватель Алета Сабанова из Дворца детского творчества в Беслане.';
  assert.equal(sentences(intro.split('\n')[0]).length, 1);
  assert.deepEqual(text(intro), { from: 'intro', text: 'Фильм посвящён 10-летию террористического акта в Беслане, где в сентябре 2004 года произошёл захват школы № 1.' });
}

// 8. Справка без точки в конце, о чём фильм — сказано: раздела «Сюжет» нет — берём её, с точкой
assert.deepEqual(text('«Знамя партии» — советский чёрно-белый научно-популярный фильм 1961 года о революционном и общественно-политическом движении до февраля 1917 года', null), {
  from: 'intro', text: '«Знамя партии» — советский чёрно-белый научно-популярный фильм 1961 года о революционном и общественно-политическом движении до февраля 1917 года.',
});

// 9. «Дипломант XV ВКФ.» — мимо; «Мультфильм о псе…» — сюжет
assert.deepEqual(text('«Сезон охоты» — советский рисованный мультипликационный фильм, созданный в 1981 году на студии «Киевнаучфильм».\nДипломант XV ВКФ.\nМультфильм о псе охотничьей породы, мечтавшем пойти на охоту.'), {
  from: 'intro', text: 'Мультфильм о псе охотничьей породы, мечтавшем пойти на охоту.',
});

// 10. Премьера, повторный показ, «посвящён выпуск программы» — не сюжет; справка «посвящённый судьбе…» — остаётся
assert.deepEqual(text('«Легенды о Круге» — российский четырёхсерийный мини-сериал, посвящённый судьбе известного автора и исполнителя песен Михаила Круга.\nПремьера состоялась 22 апреля 2013 года на Первом канале, повторный показ прошёл там же 10 января 2014 года. В апреле 2013 года фильму был посвящён выпуск программы «Пусть говорят»; тогда в студии актёры встретились со своими прототипами.', null), {
  from: 'intro', text: '«Легенды о Круге» — российский четырёхсерийный мини-сериал, посвящённый судьбе известного автора и исполнителя песен Михаила Круга.',
});

// 11. Во вступлении — только справка (альманах, дебют, «фраза-угроза» — не о сюжете): берём первый абзац «Сюжета»,
//     дальше него — нет (там развязка); развязка «В конце…» и в самом абзаце не идёт
{
  const intro = '«Ну, погоди!» — советский рисованный мультфильм студии «Союзмультфильм» 1969 года. Четвёртый из четырёх сюжетов мультипликационного альманаха «Весёлая карусель» № 1. Режиссёрский дебют режиссёра-мультипликатора Геннадия Сокольского.\n«Ну, погоди!» — это фраза-угроза Волка в сторону Зайца, которого он постоянно пытается поймать. Картина является прототипом появившегося позже мультипликационного сериала «Ну, погоди!», первая серия которого вышла в том же 1969 году.';
  assert.deepEqual(filmBlurb(intro, undefined), { need: 'plot' });
  const full = 'Вступление.\n\n== Сюжет ==\nВолк гонится за Зайцем по городу. Заяц прячется в телефонной будке. В конце Волк остаётся ни с чем.\nВо втором абзаце — развязка.\n\n== Создатели ==\nРежиссёр.';
  const plot = plotSection(full);
  assert.equal(plot, 'Волк гонится за Зайцем по городу. Заяц прячется в телефонной будке. В конце Волк остаётся ни с чем.');
  assert.deepEqual(text(intro, plot), { from: 'plot', text: 'Волк гонится за Зайцем по городу. Заяц прячется в телефонной будке.' });
  assert.equal(plotSection('Вступление.\n\n== Создатели ==\nРежиссёр.'), null);
}

console.log('film-blurbs: обрезка — ок');

// 12. Раздел «Сюжет» из вики-текста: сноски, шаблоны, ссылки, картинка — в простой текст
assert.equal(plotFromWikitext(`'''«Ёжик в тумане»''' — мультфильм.

== Сюжет ==
[[Файл:Ёжик.jpg|мини|Ёжик и [[Медвежонок]]]]
{{Врезка|текст}}
Каждый вечер [[Ёжик (персонаж)|Ёжик]] ходит к Медвежонку&nbsp;— считать звёзды.<ref>{{cite web|url=http://x}}</ref> По дороге он видит в тумане {{nobr|белую лошадь}}<ref name="a" />.

Во втором абзаце — развязка.

== Создатели ==
* Режиссёр`), 'Каждый вечер Ёжик ходит к Медвежонку — считать звёзды. По дороге он видит в тумане белую лошадь.');

console.log('film-blurbs: вики-текст — ок');
