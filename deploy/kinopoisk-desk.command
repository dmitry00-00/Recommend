#!/bin/bash
# Пульт импорта оценок с Кинопоиска — теперь вкладка общего пульта (deploy/desk.command):
# откроется сразу на ней. Бросаешь страницы «Оценки и просмотры», вписываешь ник Telegram,
# «Собрать» → seeds/<ник>.json, «Отправить» → профиль на сервере.
exec "$(dirname "$0")/desk.command" kinopoisk
