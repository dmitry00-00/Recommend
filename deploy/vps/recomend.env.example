# /etc/recomend.env — переменные сервера recomend (server/index.js, worker/*). Шаблон БЕЗ значений: в git только он.
# setup.sh кладёт копию в /etc/recomend.env (root:root, 600); значения вписываются там: sudo nano /etc/recomend.env,
# затем sudo systemctl restart recomend. Значения — из панели bothost (раздел переменных бота) и из .env.local.
# Формат systemd EnvironmentFile: KEY=значение, без export, кавычки не нужны; # — комментарий.
# Пустое «KEY=» сервер понимает как «не задано». Строки, где пустое значение означало бы 0, закомментированы — их
# раскомментируют только с числом.

# ─── обязательные ────────────────────────────────────────────────────────────────────────────────────────────────────
# Токен бота @recomend_media_bot (BotFather). Им проверяется подпись initData (вход в Mini App), им же сервер шлёт
# сводки подписок, ответы инлайна и сообщения владельцу. Тот же, что на bothost. TELEGRAM_BOT_TOKEN — синоним (читается,
# если BOT_TOKEN пуст).
BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Токен сборщика и пультов: справочники (tools/publish-reference.mts), реестр, копии базы (/api/admin/backups,
# /api/admin/restore), вебхук (tools/tg-webhook.mts). На Mac он же — TM_ADMIN_TOKEN в .env.local. Проще всего —
# тот же, что на bothost; новый — `openssl rand -hex 32`, и тогда заменить TM_ADMIN_TOKEN в .env.local.
ADMIN_TOKEN=

# Номер аккаунта Telegram владельца (цифры): задан — роль админа только по нему, а не по нику; ему же сервер пишет
# о битой базе и нехватке места.
OWNER_TG_ID=

# Свой адрес, https://… без слеша на конце: ровно тот, что в Caddyfile и в BotFather (новый домен или
# <ip-с-дефисами>.sslip.io). Без него не ставится вебхук инлайна (worker/inline.ts сверяет адрес вебхука с ним) и
# публичные страницы строят адрес по запросу.
PUBLIC_ORIGIN=

# Через запятую: чужие адреса, которым сервер ответит на кросс-доменные запросы (CORS). Своему адресу CORS не нужен —
# Mini App ходит в /api того же адреса. Пусто — только свой (так на bothost сейчас, если там не задано иное — сверить).
ALLOWED_ORIGINS=

# ─── ключи внешних API (без них — 503 у соответствующего прокси) ─────────────────────────────────────────────────────
# kinopoiskapiunofficial.tech → /kp-api/* (квота 500 запросов в сутки на ключ)
KP_API_KEY=
# TMDb (ключ v3 или токен чтения v4) → /tmdb-api/* и картинки /img/tmdb/*. На bothost его НЕТ — завести
# (на Mac он есть как VITE_TMDB_API_KEY в .env.local; тот же годится)
TMDB_API_KEY=

# ─── владелец и вход ─────────────────────────────────────────────────────────────────────────────────────────────────
# Ник владельца без @ (по умолчанию Tacticheskiy_Enot): его профиль при первом входе получает историю из
# seed/owner.json; роль админа по нику — только пока не задан OWNER_TG_ID
OWNER_USERNAME=
# «0» закрывает гостевой вход вне Telegram (по умолчанию открыт: анонимный участник на браузер). Сверить с bothost
ALLOW_DEMO=

# ─── публичные страницы (ЗП-15) ──────────────────────────────────────────────────────────────────────────────────────
# «1» — /film/*, /author/*, robots.txt, sitemap.xml для поисковиков (выключены до решения владельца, 07.10)
PUBLIC_PAGES=

# ─── данные и копии ──────────────────────────────────────────────────────────────────────────────────────────────────
# DATA_DIR и PORT задаёт recomend.service (/var/lib/recomend, 3000). Здесь — только если менять, и только непустыми:
# пустое значение отсюда перекрыло бы службу, и сервер писал бы базу в папку кода (а та — только для чтения)
# DATA_DIR=/var/lib/recomend
# PORT=3000
# Сколько копий базы держать в DATA_DIR/backups (по умолчанию 14: ночные, ручные, перед выкладкой/восстановлением)
BACKUP_KEEP=
# Предел кеша картинок TMDb в DATA_DIR/img-cache, МБ (по умолчанию 512)
IMG_CACHE_MB=
# «sqljs» — база в памяти через sql.js, как до 06.10 (аварийный вариант); по умолчанию — node:sqlite, файл
DB_ENGINE=
# «0» — без потоков базы (миграции, копии, аналитика — в главном потоке, как до 18.10); по умолчанию — потоки
DB_THREADS=

# ─── настройка памяти (пустое значение = 0, поэтому закомментированы; машина 2 ГБ) ───────────────────────────────────
# Кэш страниц SQLite, МБ (64) и отображение файла базы в память, МБ (256; 0 — выключить) — server/d1-sqlite.js
# DB_CACHE_MB=64
# DB_MMAP_MB=256
# Предел кучи потока аналитики владельца, МБ (512; server/db-thread.js). На 2 ГБ — не поднимать
# ANALYTICS_HEAP_MB=512
# Предел кучи главного потока Node (по умолчанию Node выбирает сам по объёму памяти)
# NODE_OPTIONS=--max-old-space-size=1024

# ─── обслуживание базы (worker/retention.ts; выключено) ──────────────────────────────────────────────────────────────
# «1» — ночная свёртка показов старше 120 дней
IMPRESSION_ROLLUP=
# «1» — урезанная карточка рядом с отметкой (новые записи и разовый перенос)
SLIM_CARDS=

# Не читается сервером Node (только Cloudflare-контуром): BOT_USERNAME — имя бота берётся по умолчанию recomend_media_bot.
